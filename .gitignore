# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PyInstaller — artefacts uniquement ; les scripts build/build.* sont versionnés.
# Le .gitignore racine du dépôt exclut « build/ » : on ré-inclut ce dossier-ci,
# sinon les scripts de build sont silencieusement ignorés (cas du commit 71a0fe8).
!build/
build/MMdedit/
build/*.spec
dist/
*.spec.bak

# OS
.DS_Store
Thumbs.db
